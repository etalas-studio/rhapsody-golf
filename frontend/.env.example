# Supabase (add when Phase 1 backend integration starts)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend AI agent URL (add when backend/ is deployed)
VITE_BACKEND_URL=http://localhost:3001

# Midtrans (set IS_PRODUCTION=true and use production keys on prod)
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
VITE_MIDTRANS_IS_PRODUCTION=false
